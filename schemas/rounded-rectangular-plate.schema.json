{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invisra.com/printspec/0.1.0/rounded-rectangular-plate.schema.json",
  "type": "object",
  "required": [
    "type",
    "label",
    "parameters"
  ],
  "properties": {
    "type": {
      "const": "rounded_rectangular_plate"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "required": [
        "length",
        "width",
        "thickness",
        "cornerRadius"
      ],
      "properties": {
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "cornerRadius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "holes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Hole"
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Slot"
          }
        },
        "chamfer": {
          "$ref": "common.schema.json#/$defs/Chamfer"
        },
        "fillet": {
          "$ref": "common.schema.json#/$defs/Fillet"
        }
      },
      "additionalProperties": false
    },
    "hardware": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/HardwareItem"
      }
    }
  },
  "additionalProperties": false
}
