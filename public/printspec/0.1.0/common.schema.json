{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invisra.ai/printspec/0.1.0/common.schema.json",
  "$defs": {
    "Dimension": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000,
      "title": "Dimension",
      "description": " dimension parameter."
    },
    "Point2D": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "title": "X",
          "description": "X parameter."
        },
        "y": {
          "type": "number",
          "title": "Y",
          "description": "Y parameter."
        }
      },
      "additionalProperties": false,
      "title": "Point2D",
      "description": " point2 d parameter."
    },
    "Point3D": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number",
          "title": "X",
          "description": "X parameter."
        },
        "y": {
          "type": "number",
          "title": "Y",
          "description": "Y parameter."
        },
        "z": {
          "type": "number",
          "title": "Z",
          "description": "Z parameter."
        }
      },
      "additionalProperties": false,
      "title": "Point3D",
      "description": " point3 d parameter."
    },
    "Countersink": {
      "type": "object",
      "required": [
        "diameter",
        "angle"
      ],
      "properties": {
        "diameter": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Diameter",
          "description": "Diameter in millimeters."
        },
        "angle": {
          "type": "number",
          "minimum": 1,
          "maximum": 179,
          "title": "Angle",
          "description": "Angle parameter."
        }
      },
      "additionalProperties": false,
      "title": "Countersink",
      "description": " countersink for the part."
    },
    "Counterbore": {
      "type": "object",
      "required": [
        "diameter",
        "depth"
      ],
      "properties": {
        "diameter": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Diameter",
          "description": "Diameter in millimeters."
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Depth",
          "description": "Depth in millimeters."
        }
      },
      "additionalProperties": false,
      "title": "Counterbore",
      "description": " counterbore for the part."
    },
    "Hole": {
      "type": "object",
      "required": [
        "x",
        "y",
        "diameter",
        "depth"
      ],
      "properties": {
        "id": {
          "type": "string",
          "title": "Id",
          "description": "Id parameter."
        },
        "x": {
          "type": "number",
          "title": "X",
          "description": "X parameter."
        },
        "y": {
          "type": "number",
          "title": "Y",
          "description": "Y parameter."
        },
        "diameter": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Diameter",
          "description": "Diameter in millimeters."
        },
        "depth": {
          "oneOf": [
            {
              "const": "through"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000,
              "title": "OneOf",
              "description": "One of parameter."
            }
          ]
        },
        "axis": {
          "enum": [
            "x",
            "y",
            "z"
          ],
          "default": "z",
          "title": "Axis",
          "description": "Axis parameter.",
          "examples": [
            "z"
          ],
          "x-printspec-enumLabels": {
            "x": "X axis",
            "y": "Y axis",
            "z": "Z axis"
          }
        },
        "countersink": {
          "$ref": "#/$defs/Countersink",
          "title": "Countersink",
          "description": "Countersink for the part."
        },
        "counterbore": {
          "$ref": "#/$defs/Counterbore",
          "title": "Counterbore",
          "description": "Counterbore for the part."
        }
      },
      "additionalProperties": false,
      "title": "Hole",
      "description": " hole parameter."
    },
    "Slot": {
      "type": "object",
      "required": [
        "x",
        "y",
        "length",
        "width",
        "depth",
        "axis"
      ],
      "properties": {
        "id": {
          "type": "string",
          "title": "Id",
          "description": "Id parameter."
        },
        "x": {
          "type": "number",
          "title": "X",
          "description": "X parameter."
        },
        "y": {
          "type": "number",
          "title": "Y",
          "description": "Y parameter."
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Length",
          "description": "Length in millimeters."
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Width",
          "description": "Width in millimeters."
        },
        "depth": {
          "oneOf": [
            {
              "const": "through"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000,
              "title": "OneOf",
              "description": "One of parameter."
            }
          ]
        },
        "axis": {
          "enum": [
            "x",
            "y",
            "z"
          ],
          "title": "Axis",
          "description": "Axis parameter.",
          "default": "z",
          "examples": [
            "z"
          ],
          "x-printspec-enumLabels": {
            "x": "X axis",
            "y": "Y axis",
            "z": "Z axis"
          }
        }
      },
      "additionalProperties": false,
      "title": "Slot",
      "description": " slot parameter."
    },
    "Fillet": {
      "type": "object",
      "required": [
        "radius"
      ],
      "properties": {
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Radius",
          "description": "Radius in millimeters."
        },
        "target": {
          "type": "string",
          "title": "Target",
          "description": "Target parameter."
        }
      },
      "additionalProperties": false,
      "title": "Fillet",
      "description": " fillet parameter."
    },
    "Chamfer": {
      "type": "object",
      "required": [
        "distance"
      ],
      "properties": {
        "distance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Distance",
          "description": "Distance parameter."
        },
        "target": {
          "type": "string",
          "title": "Target",
          "description": "Target parameter."
        }
      },
      "additionalProperties": false,
      "title": "Chamfer",
      "description": " chamfer parameter."
    },
    "Pattern": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "countX",
            "countY",
            "spacingX",
            "spacingY"
          ],
          "properties": {
            "type": {
              "const": "rectangular"
            },
            "countX": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "title": "CountX",
              "description": "Count x for the part."
            },
            "countY": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "title": "CountY",
              "description": "Count y for the part."
            },
            "spacingX": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000,
              "title": "SpacingX",
              "description": "Spacing x in millimeters."
            },
            "spacingY": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000,
              "title": "SpacingY",
              "description": "Spacing y in millimeters."
            }
          },
          "additionalProperties": false,
          "title": "OneOf",
          "description": "One of parameter."
        },
        {
          "type": "object",
          "required": [
            "type",
            "count",
            "spacing"
          ],
          "properties": {
            "type": {
              "const": "linear"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "title": "Count",
              "description": "Count for the part."
            },
            "spacing": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000,
              "title": "Spacing",
              "description": "Spacing in millimeters."
            },
            "axis": {
              "enum": [
                "x",
                "y",
                "z"
              ],
              "title": "Axis",
              "description": "Axis parameter.",
              "default": "z",
              "examples": [
                "z"
              ],
              "x-printspec-enumLabels": {
                "x": "X axis",
                "y": "Y axis",
                "z": "Z axis"
              }
            }
          },
          "additionalProperties": false,
          "title": "OneOf",
          "description": "One of parameter."
        },
        {
          "type": "object",
          "required": [
            "type",
            "count",
            "radius"
          ],
          "properties": {
            "type": {
              "const": "radial"
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "title": "Count",
              "description": "Count for the part."
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000,
              "title": "Radius",
              "description": "Radius in millimeters."
            },
            "startAngle": {
              "type": "number",
              "title": "StartAngle",
              "description": "Start angle parameter."
            },
            "sweepAngle": {
              "type": "number",
              "title": "SweepAngle",
              "description": "Sweep angle parameter."
            }
          },
          "additionalProperties": false,
          "title": "OneOf",
          "description": "One of parameter."
        }
      ]
    },
    "SupplierReference": {
      "type": "object",
      "required": [
        "supplier",
        "partNumber"
      ],
      "properties": {
        "supplier": {
          "type": "string",
          "minLength": 1,
          "title": "Supplier",
          "description": "Supplier parameter."
        },
        "partNumber": {
          "type": "string",
          "minLength": 1,
          "title": "PartNumber",
          "description": "Part number parameter."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "title": "Url",
          "description": "Url parameter."
        },
        "description": {
          "type": "string",
          "title": "Description",
          "description": "Description parameter."
        }
      },
      "additionalProperties": false,
      "title": "SupplierReference",
      "description": " supplier reference parameter."
    },
    "HardwareItem": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "quantity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "title": "Id",
          "description": "Id parameter."
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "title": "Kind",
          "description": "Kind parameter."
        },
        "standard": {
          "type": "string",
          "title": "Standard",
          "description": "Standard parameter."
        },
        "size": {
          "type": "string",
          "title": "Size",
          "description": "Size parameter."
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "title": "Quantity",
          "description": "Quantity parameter."
        },
        "role": {
          "type": "string",
          "title": "Role",
          "description": "Role parameter."
        },
        "supplierReferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SupplierReference",
            "title": "Items",
            "description": "Items parameter."
          },
          "title": "SupplierReferences",
          "description": "Supplier references parameter."
        }
      },
      "additionalProperties": false,
      "title": "HardwareItem",
      "description": " hardware item parameter."
    }
  },
  "title": "Common Printspec Definitions",
  "description": "Reusable JSON Schema definitions shared by printspec schemas."
}
