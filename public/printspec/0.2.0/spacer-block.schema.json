{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invisra.ai/printspec/0.2.0/spacer-block.schema.json",
  "type": "object",
  "required": [
    "type",
    "label",
    "parameters"
  ],
  "properties": {
    "type": {
      "const": "spacer_block",
      "title": "Part type",
      "description": "Stable printspec part family identifier."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "title": "Label",
      "description": "Human-readable name for this part."
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Optional human-readable notes for this part."
    },
    "parameters": {
      "type": "object",
      "required": [
        "length",
        "width",
        "height"
      ],
      "properties": {
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Length",
          "description": "Length in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary",
          "examples": [
            100
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Width",
          "description": "Width in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary",
          "examples": [
            50
          ]
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Height",
          "description": "Height in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary",
          "examples": [
            10
          ]
        },
        "holes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Hole"
          },
          "title": "Holes",
          "description": "Optional hole features to include in the generated part.",
          "x-printspec-control": "hole-list",
          "x-printspec-priority": "advanced",
          "default": []
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Slot"
          },
          "title": "Slots",
          "description": "Optional slot features to include in the generated part.",
          "x-printspec-control": "slot-list",
          "x-printspec-priority": "advanced",
          "default": []
        },
        "chamfer": {
          "$ref": "common.schema.json#/$defs/Chamfer",
          "title": "Chamfer",
          "description": "Optional chamfer edge finishing request.",
          "x-printspec-control": "number",
          "x-printspec-priority": "advanced"
        },
        "fillet": {
          "$ref": "common.schema.json#/$defs/Fillet",
          "title": "Fillet",
          "description": "Optional fillet edge finishing request.",
          "x-printspec-control": "number",
          "x-printspec-priority": "advanced"
        },
        "cornerRadius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Corner radius",
          "description": "Corner radius in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "advanced",
          "examples": [
            4
          ]
        }
      },
      "additionalProperties": false,
      "title": "Parameters",
      "description": "Editable parameters for Spacer Block.",
      "x-printspec-ui": {
        "order": [
          "length",
          "width",
          "height",
          "cornerRadius",
          "holes",
          "slots",
          "chamfer",
          "fillet"
        ],
        "groups": [
          {
            "id": "dimensions",
            "title": "Dimensions",
            "fields": [
              "length",
              "width",
              "height",
              "cornerRadius"
            ]
          },
          {
            "id": "features",
            "title": "Features",
            "fields": [
              "holes",
              "slots"
            ]
          },
          {
            "id": "finishing",
            "title": "Finishing",
            "fields": [
              "chamfer",
              "fillet"
            ]
          }
        ]
      }
    },
    "hardware": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/HardwareItem"
      }
    }
  },
  "additionalProperties": false,
  "title": "Spacer Block",
  "description": "Rectangular spacer block with optional holes, slots, and edge finishing."
}
