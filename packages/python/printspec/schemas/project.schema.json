{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "type",
    "label",
    "parts"
  ],
  "properties": {
    "type": {
      "const": "project",
      "title": "Part type",
      "description": "Stable printspec part family identifier."
    },
    "label": {
      "type": "string",
      "title": "Label",
      "description": "Human-readable name for this part."
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Optional human-readable notes for this part."
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "spec": {
            "$ref": "printspec.schema.json"
          },
          "specPath": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "spec"
            ]
          },
          {
            "required": [
              "specPath"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    "hardware": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/HardwareItem"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "partA"
        ],
        "properties": {
          "type": {
            "enum": [
              "mates_with",
              "fastens",
              "inserts_into",
              "aligns_with"
            ]
          },
          "partA": {
            "type": "string"
          },
          "partB": {
            "type": "string"
          },
          "hardware": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "package": {
      "type": "object"
    },
    "partcad": {
      "type": "object",
      "properties": {
        "packageName": {
          "type": "string"
        },
        "packageVersion": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://schemas.invisra.ai/printspec/0.2.0/project.schema.json",
  "title": "Project",
  "description": "Project schema for printspec documents."
}
