{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invisra.ai/printspec/0.2.0/drill-guide.schema.json",
  "type": "object",
  "required": [
    "type",
    "label",
    "parameters"
  ],
  "properties": {
    "type": {
      "const": "drill_guide",
      "title": "Part type",
      "description": "Stable printspec part family identifier."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "title": "Label",
      "description": "Human-readable name for this part."
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Optional human-readable notes for this part."
    },
    "parameters": {
      "type": "object",
      "required": [
        "length",
        "width",
        "height",
        "holeDiameter",
        "holeCount",
        "holeSpacing"
      ],
      "properties": {
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Length",
          "description": "Length in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary",
          "examples": [
            100
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Width",
          "description": "Width in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary",
          "examples": [
            50
          ]
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Height",
          "description": "Height in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary",
          "examples": [
            10
          ]
        },
        "holeDiameter": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Hole diameter",
          "description": "Hole diameter in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary",
          "examples": [
            3.2
          ]
        },
        "holeCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "title": "Hole count",
          "description": "Hole count for the part.",
          "x-printspec-control": "integer",
          "x-printspec-unit": "count",
          "x-printspec-step": 1,
          "x-printspec-priority": "primary"
        },
        "holeSpacing": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Hole spacing",
          "description": "Hole spacing in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary"
        },
        "bushingDiameter": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Bushing diameter",
          "description": "Bushing diameter in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "advanced"
        },
        "holes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Hole"
          },
          "title": "Holes",
          "description": "Optional hole features to include in the generated part.",
          "x-printspec-control": "hole-list",
          "x-printspec-priority": "advanced",
          "default": []
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Slot"
          },
          "title": "Slots",
          "description": "Optional slot features to include in the generated part.",
          "x-printspec-control": "slot-list",
          "x-printspec-priority": "advanced",
          "default": []
        },
        "chamfer": {
          "$ref": "common.schema.json#/$defs/Chamfer",
          "title": "Chamfer",
          "description": "Optional chamfer edge finishing request.",
          "x-printspec-control": "number",
          "x-printspec-priority": "advanced"
        },
        "fillet": {
          "$ref": "common.schema.json#/$defs/Fillet",
          "title": "Fillet",
          "description": "Optional fillet edge finishing request.",
          "x-printspec-control": "number",
          "x-printspec-priority": "advanced"
        },
        "cornerRadius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Corner radius",
          "description": "Corner radius in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "advanced",
          "examples": [
            4
          ]
        }
      },
      "additionalProperties": false,
      "title": "Parameters",
      "description": "Editable parameters for Drill Guide.",
      "x-printspec-ui": {
        "order": [
          "length",
          "width",
          "height",
          "holeDiameter",
          "holeCount",
          "holeSpacing",
          "bushingDiameter",
          "holes",
          "slots",
          "chamfer",
          "fillet",
          "cornerRadius"
        ],
        "groups": [
          {
            "id": "parameters",
            "title": "Parameters",
            "fields": [
              "length",
              "width",
              "height",
              "holeDiameter",
              "holeCount",
              "holeSpacing",
              "bushingDiameter",
              "holes",
              "slots",
              "chamfer",
              "fillet",
              "cornerRadius"
            ]
          }
        ]
      }
    },
    "hardware": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/HardwareItem"
      }
    }
  },
  "additionalProperties": false,
  "title": "Drill Guide",
  "description": "Block used to guide repeated drilled holes."
}
