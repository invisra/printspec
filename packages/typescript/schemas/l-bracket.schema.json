{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invisra.ai/printspec/0.2.0/l-bracket.schema.json",
  "type": "object",
  "required": [
    "type",
    "label",
    "parameters"
  ],
  "properties": {
    "type": {
      "const": "l_bracket",
      "title": "Part type",
      "description": "Stable printspec part family identifier."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "title": "Label",
      "description": "Human-readable name for this part."
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Optional human-readable notes for this part."
    },
    "parameters": {
      "type": "object",
      "required": [
        "legLengthA",
        "legLengthB",
        "width",
        "thickness"
      ],
      "properties": {
        "legLengthA": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Leg A length",
          "description": "Leg A length in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary"
        },
        "legLengthB": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Leg B length",
          "description": "Leg B length in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Width",
          "description": "Width in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary",
          "examples": [
            50
          ]
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Thickness",
          "description": "Thickness in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary",
          "examples": [
            3
          ]
        },
        "holes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Hole"
          },
          "title": "Holes",
          "description": "Optional hole features to include in the generated part.",
          "x-printspec-control": "hole-list",
          "x-printspec-priority": "advanced",
          "default": []
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Slot"
          },
          "title": "Slots",
          "description": "Optional slot features to include in the generated part.",
          "x-printspec-control": "slot-list",
          "x-printspec-priority": "advanced",
          "default": []
        },
        "chamfer": {
          "$ref": "common.schema.json#/$defs/Chamfer",
          "title": "Chamfer",
          "description": "Optional chamfer edge finishing request.",
          "x-printspec-control": "number",
          "x-printspec-priority": "advanced"
        },
        "fillet": {
          "$ref": "common.schema.json#/$defs/Fillet",
          "title": "Fillet",
          "description": "Optional fillet edge finishing request.",
          "x-printspec-control": "number",
          "x-printspec-priority": "advanced"
        },
        "cornerRadius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Corner radius",
          "description": "Corner radius in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "advanced",
          "examples": [
            4
          ]
        },
        "rib": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether to add a reinforcing rib along the inside corner of the bracket."
            },
            "thickness": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000,
              "description": "Rib thickness in millimeters."
            }
          },
          "additionalProperties": false,
          "title": "Rib",
          "description": "Optional reinforcing rib along the inside corner of the bracket.",
          "x-printspec-control": "number",
          "x-printspec-priority": "advanced"
        }
      },
      "additionalProperties": false,
      "title": "Parameters",
      "description": "Editable parameters for L Bracket.",
      "x-printspec-ui": {
        "order": [
          "legLengthA",
          "legLengthB",
          "width",
          "thickness",
          "holes",
          "slots",
          "chamfer",
          "fillet",
          "cornerRadius",
          "rib"
        ],
        "groups": [
          {
            "id": "parameters",
            "title": "Parameters",
            "fields": [
              "legLengthA",
              "legLengthB",
              "width",
              "thickness",
              "holes",
              "slots",
              "chamfer",
              "fillet",
              "cornerRadius",
              "rib"
            ]
          }
        ]
      }
    },
    "hardware": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/HardwareItem"
      }
    }
  },
  "additionalProperties": false,
  "title": "L Bracket",
  "description": "Two-leg right-angle bracket with optional mounting features."
}
