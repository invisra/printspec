{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invisra.ai/printspec/0.2.0/cable-clip.schema.json",
  "type": "object",
  "required": [
    "type",
    "label",
    "parameters"
  ],
  "properties": {
    "type": {
      "const": "cable_clip",
      "title": "Part type",
      "description": "Stable printspec part family identifier."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "title": "Label",
      "description": "Human-readable name for this part."
    },
    "description": {
      "type": "string",
      "title": "Description",
      "description": "Optional human-readable notes for this part."
    },
    "parameters": {
      "type": "object",
      "required": [
        "baseLength",
        "baseWidth",
        "baseThickness",
        "clipWallThickness"
      ],
      "properties": {
        "baseLength": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Base length",
          "description": "Base length in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary"
        },
        "baseWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Base width",
          "description": "Base width in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary"
        },
        "baseThickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Base thickness",
          "description": "Base thickness in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary"
        },
        "clipInnerDiameter": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Clip inner diameter",
          "description": "Clip inner diameter in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "advanced"
        },
        "clipOpeningWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Clip opening width",
          "description": "Clip opening width in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "advanced"
        },
        "clipWallThickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Clip wall thickness",
          "description": "Clip wall thickness in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "primary"
        },
        "holes": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Hole"
          },
          "title": "Holes",
          "description": "Optional hole features to include in the generated part.",
          "x-printspec-control": "hole-list",
          "x-printspec-priority": "advanced",
          "default": []
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Slot"
          },
          "title": "Slots",
          "description": "Optional slot features to include in the generated part.",
          "x-printspec-control": "slot-list",
          "x-printspec-priority": "advanced",
          "default": []
        },
        "chamfer": {
          "$ref": "common.schema.json#/$defs/Chamfer",
          "title": "Chamfer",
          "description": "Optional chamfer edge finishing request.",
          "x-printspec-control": "number",
          "x-printspec-priority": "advanced"
        },
        "fillet": {
          "$ref": "common.schema.json#/$defs/Fillet",
          "title": "Fillet",
          "description": "Optional fillet edge finishing request.",
          "x-printspec-control": "number",
          "x-printspec-priority": "advanced"
        },
        "cornerRadius": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Corner radius",
          "description": "Corner radius in millimeters.",
          "x-printspec-control": "number",
          "x-printspec-unit": "mm",
          "x-printspec-step": 0.1,
          "x-printspec-priority": "advanced",
          "examples": [
            4
          ]
        },
        "mountingHoles": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Hole"
          },
          "title": "Mounting holes",
          "description": "Optional hole features to include in the generated part.",
          "x-printspec-control": "hole-list",
          "x-printspec-priority": "advanced",
          "default": []
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "clipInnerDiameter"
          ]
        },
        {
          "required": [
            "clipOpeningWidth"
          ]
        }
      ],
      "title": "Parameters",
      "description": "Editable parameters for Cable Clip.",
      "x-printspec-ui": {
        "order": [
          "baseLength",
          "baseWidth",
          "baseThickness",
          "clipInnerDiameter",
          "clipOpeningWidth",
          "clipWallThickness",
          "holes",
          "slots",
          "chamfer",
          "fillet",
          "cornerRadius",
          "mountingHoles"
        ],
        "groups": [
          {
            "id": "parameters",
            "title": "Parameters",
            "fields": [
              "baseLength",
              "baseWidth",
              "baseThickness",
              "clipInnerDiameter",
              "clipOpeningWidth",
              "clipWallThickness",
              "holes",
              "slots",
              "chamfer",
              "fillet",
              "cornerRadius",
              "mountingHoles"
            ]
          }
        ]
      }
    },
    "hardware": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/HardwareItem"
      }
    }
  },
  "additionalProperties": false,
  "title": "Cable Clip",
  "description": "Mountable clip for holding a cable or hose."
}
