{
  "name": "printspec-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/typescript"
  ],
  "type": "module",
  "scripts": {
    "build": "npm --workspace @invisra/printspec run build",
    "test": "npm run test:ts",
    "test:ts": "npm --workspace @invisra/printspec test",
    "test:python": "pytest tests/python tests/schema",
    "test:schema": "python -m pytest tests/schema",
    "lint": "npm --workspace @invisra/printspec run build"
  }
}
